{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "building",
    "floor",
    "rooms"
  ],
  "properties": {
    "building": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "maxLength": 64
    },
    "floor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "center"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "maxLength": 64
          },
          "center": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "polygon": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 3
          }
        }
      },
      "minItems": 1
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 0
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 0
    },
    "stairs": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 0
    },
    "furniture": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "center"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "maxLength": 64
          },
          "center": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "minItems": 0
    }
  }
}
