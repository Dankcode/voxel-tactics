{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "theme",
    "timeOfDay",
    "frame",
    "buildings",
    "surfaces",
    "insertion",
    "flow"
  ],
  "properties": {
    "version": {
      "enum": [
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "theme": {
      "enum": [
        "Suburbs",
        "Downtown",
        "Industrial",
        "Roadside"
      ]
    },
    "timeOfDay": {
      "enum": [
        "day",
        "dusk",
        "night",
        "dawn",
        "overcast"
      ]
    },
    "frame": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1
        },
        "height": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "bounds",
          "storeys",
          "program",
          "front"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 64
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "storeys": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "program": {
            "enum": [
              "house",
              "office",
              "warehouse",
              "shop",
              "garage",
              "diner"
            ]
          },
          "front": {
            "enum": [
              "n",
              "s",
              "e",
              "w"
            ]
          }
        }
      },
      "minItems": 1
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bounds",
          "material"
        ],
        "properties": {
          "bounds": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "material": {
            "enum": [
              "lawn",
              "concrete",
              "paving",
              "asphalt",
              "deck"
            ]
          }
        }
      },
      "minItems": 0
    },
    "insertion": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "flow": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 2,
      "maxItems": 6
    },
    "storyHooks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "minItems": 0
    },
    "style": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    }
  }
}
